import pandas as pd

# 定义别名映射
alias_map = {
    'K药': '帕博利珠单抗',
    'O药': '纳武利珠单抗',
    '拓益': '特瑞普利单抗',
    '艾瑞卡': '卡瑞利珠单抗',
    '达伯舒': '信迪利单抗',
    '百泽安': '替雷利珠单抗'
}
target_keywords = list(alias_map.keys()) + list(alias_map.values())

# 构建匹配模式
pattern = '|'.join(target_keywords)

# 筛选目标药物
mask_drug = df['药品名称'].astype(str).str.contains(pattern, na=False) | df['成分名'].astype(str).str.contains(pattern, na=False)
df_target = df[mask_drug].copy()

# 初始化结果表结构
columns_out = ['药品名称', '2024销售额', '2024份额(%)', '2025销售额', '2025份额(%)', '份额变化(%)']

if df_target.empty:
    result = pd.DataFrame(columns=columns_out)
else:
    # 提取年份
    df_target['年份'] = df_target['年季'].astype(str).str[:4]
    df['年份'] = df['年季'].astype(str).str[:4]
    
    # 1. 计算产品销售额
    sales_drug = df_target.groupby(['药品名称', '定义市场', '年份'])['销售额'].sum().reset_index()
    
    # 2. 计算定义市场总销售额 (分母)
    related_markets = df_target['定义市场'].unique()
    df_market = df[df['定义市场'].isin(related_markets)]
    market_totals = df_market.groupby(['定义市场', '年份'])['销售额'].sum().reset_index().rename(columns={'销售额': '市场总额'})
    
    # 3. 合并计算份额
    merged = pd.merge(sales_drug, market_totals, on=['定义市场', '年份'], how='left')
    merged['份额'] = 0.0
    mask_valid = merged['市场总额'] > 0
    merged.loc[mask_valid, '份额'] = (merged.loc[mask_valid, '销售额'] / merged.loc[mask_valid, '市场总额'] * 100).round(1)
    
    # 4. 透视表转置年份
    pivot = merged.pivot_table(index='药品名称', columns='年份', values=['销售额', '份额'], aggfunc='sum')
    
    # 展平 MultiIndex 列名
    # pivot.columns 例如: ('销售额', '2024'), ('份额', '2025')
    pivot.columns = [f'{c[1]}{c[0]}' for c in pivot.columns]
    pivot = pivot.reset_index()
    
    # 补全可能缺失的年份列
    for y in ['2024', '2025']:
        if f'{y}销售额' not in pivot.columns: pivot[f'{y}销售额'] = 0
        if f'{y}份额' not in pivot.columns: pivot[f'{y}份额'] = 0.0
            
    # 计算份额变化
