import pandas as pd

# 定义时间范围 (MAT)
mat_quarters = ['2024Q4', '2025Q1', '2025Q2', '2025Q3']

# 1. 筛选时间范围
df_mat = df[df['年季'].isin(mat_quarters)].copy()

# 2. 计算分母：各省份的总市场规模
province_market = df_mat.groupby('省份')['销售额'].sum().reset_index()
province_market.rename(columns={'销售额': '省份总销售额'}, inplace=True)

# 3. 计算分子：康缘在各省份的销售额
# 匹配生产企业包含'康缘'
df_ky = df_mat[df_mat['生产企业'].str.contains('康缘', na=False)]
province_ky = df_ky.groupby('省份')['销售额'].sum().reset_index()
province_ky.rename(columns={'销售额': '康缘销售额'}, inplace=True)

# 4. 合并数据
result = pd.merge(province_market, province_ky, on='省份', how='left')

# 5. 处理缺失值与计算份额
result['康缘销售额'] = result['康缘销售额'].fillna(0)
result['市场份额(%)'] = (result['康缘销售额'] / result['省份总销售额'] * 100).round(1)

# 6. 格式化数据
result['康缘销售额'] = result['康缘销售额'].astype('int64')
result['省份总销售额'] = result['省份总销售额'].astype('int64')

# 7. 排序与列筛选
result = result.sort_values('市场份额(%)', ascending=False).reset_index(drop=True)
result = result[['省份', '康缘销售额', '省份总销售额', '市场份额(%)']]
