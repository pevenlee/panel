import pandas as pd

# 1. 筛选时间范围 (MAT: 2024Q4 - 2025Q3)
mat_periods = ['2024Q4', '2025Q1', '2025Q2', '2025Q3']
df_mat = df[df['年季'].isin(mat_periods)].copy()

# 2. 计算分母：每个定义市场的总销售额
market_total = df_mat.groupby('定义市场', as_index=False)['销售额'].sum()
market_total.rename(columns={'销售额': '市场总销售额'}, inplace=True)

# 3. 计算分子：康缘在每个定义市场的销售额
# 匹配生产企业包含'康缘'
kangyuan_data = df_mat[df_mat['生产企业'].str.contains('康缘', na=False)]
kangyuan_sales = kangyuan_data.groupby('定义市场', as_index=False)['销售额'].sum()
kangyuan_sales.rename(columns={'销售额': '康缘销售额'}, inplace=True)

# 4. 合并数据
result = pd.merge(market_total, kangyuan_sales, on='定义市场', how='left')

# 5. 填充空值为0 (防止某些市场康缘无销售)
result['康缘销售额'] = result['康缘销售额'].fillna(0)

# 6. 计算份额
result['康缘份额(%)'] = (result['康缘销售额'] / result['市场总销售额']) * 100

# 7. 格式化数据
result['市场总销售额'] = result['市场总销售额'].astype('int64')
result['康缘销售额'] = result['康缘销售额'].astype('int64')
result['康缘份额(%)'] = result['康缘份额(%)'].astype(float).round(1)

# 8. 排序并重置索引
result = result.sort_values(by='康缘份额(%)', ascending=False).reset_index(drop=True)
