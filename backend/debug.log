df_market_total = df_period[mask_market].groupby(['定义市场', 'TimeTag'])['销售额'].sum().reset_index()
df_market_total.rename(columns={'销售额': '市场总销售额'}, inplace=True)

# 7. 计算目标药物销售额 (分子)
df_drug_sales = df_target.groupby(['药品名称', '定义市场', 'TimeTag'])['销售额'].sum().reset_index()

# 8. 关联并计算份额
