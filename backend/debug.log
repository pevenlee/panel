import pandas as pd

# 转换销售额为数值类型
df['销售额'] = df['销售额'].fillna(0).astype('int64')

# 定义分析的时间段 (YTD 对比: 2024Q1-Q3 vs 2025Q1-Q3)
periods_2024 = ['2024Q1', '2024Q2', '2024Q3']
periods_2025 = ['2025Q1', '2025Q2', '2025Q3']

# 筛选数据
df_2024 = df[df['年季'].isin(periods_2024)]
df_2025 = df[df['年季'].isin(periods_2025)]

# 按渠道分类汇总
grouped_2024 = df_2024.groupby('渠道分类')['销售额'].sum().reset_index().rename(columns={'销售额': '2024Q1-Q3销售额'})
grouped_2025 = df_2025.groupby('渠道分类')['销售额'].sum().reset_index().rename(columns={'销售额': '2025Q1-Q3销售额'})

