import pandas as pd

# 1. 设定时间范围 (MAT)
mat_quarters = ['2024Q4', '2025Q1', '2025Q2', '2025Q3']
df_filtered = df[df['年季'].isin(mat_quarters)].copy()

# 2. 计算每个定义市场的总销售额 (分母)
market_total = df_filtered.groupby('定义市场')['销售额'].sum().reset_index()
market_total.rename(columns={'销售额': '市场总销售额'}, inplace=True)

# 3. 计算康缘在每个定义市场的销售额 (分子)
# 匹配生产企业包含“康缘”的记录
target_sales = df_filtered[df_filtered['生产企业'].str.contains('康缘', na=False)].groupby('定义市场')['销售额'].sum().reset_index()
target_sales.rename(columns={'销售额': '康缘销售额'}, inplace=True)

# 4. 合并数据并计算份额
result = pd.merge(market_total, target_sales, on='定义市场', how='left')

# 填充NaN为0 (即康缘未进入该市场)
result['康缘销售额'] = result['康缘销售额'].fillna(0)

# 计算份额 (%)
result['康缘份额(%)'] = (result['康缘销售额'] / result['市场总销售额'] * 100).round(1)

# 5. 格式化数据
# 销售额转为整数
result['康缘销售额'] = result['康缘销售额'].astype('int64')
result['市场总销售额'] = result['市场总销售额'].astype('int64')

# 排序 (按份额降序)
result = result.sort_values(by='康缘份额(%)', ascending=False).reset_index(drop=True)

# 输出结果
