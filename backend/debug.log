import pandas as pd

# 1. 定义时间范围与标签 (同口径对比: 2024 Q1-Q3 vs 2025 Q1-Q3)
# 2025年数据仅到Q3，为保证公平对比，2024年也只取前三季度
quarters_2024 = ['2024Q1', '2024Q2', '2024Q3']
quarters_2025 = ['2025Q1', '2025Q2', '2025Q3']
target_quarters = quarters_2024 + quarters_2025

# 2. 筛选时间并派生'年份'列
df_filtered = df[df['年季'].isin(target_quarters)].copy()
df_filtered['年份'] = df_filtered['年季'].str[:4]  # '2024' 或 '2025'

# 3. 计算市场总销售额 (作为份额计算的分母)
# 假设份额是指在各产品所属的“定义市场”内的份额
market_totals = df_filtered.groupby(['年份', '定义市场'])['销售额'].sum().reset_index()
market_totals.rename(columns={'销售额': '市场总额'}, inplace=False)
market_totals = market_totals.rename(columns={'销售额': '市场总额'})

# 4. 筛选目标药品
# 关键词映射: K药(帕博利珠), O药(纳武利尤), 拓益(特瑞普利), 艾瑞卡(卡瑞利珠), 达伯舒(信迪利), 百泽安(替雷利珠)
keywords = ['K药', '帕博利珠', 'Keytruda', 'O药', '纳武利尤', 'Opdivo', 
