import pandas as pd

# 定义时间范围：最新YTD为2025Q1-Q3，对比同期2024Q1-Q3
curr_periods = ['2025Q1', '2025Q2', '2025Q3']
prev_periods = ['2024Q1', '2024Q2', '2024Q3']

# 筛选数据
df_curr = df[df['年季'].isin(curr_periods)]
df_prev = df[df['年季'].isin(prev_periods)]

# 按渠道分类聚合销售额
curr_stats = df_curr.groupby('渠道分类')['销售额'].sum().reset_index().rename(columns={'销售额': '2025Q1-Q3销售额'})
prev_stats = df_prev.groupby('渠道分类')['销售额'].sum().reset_index().rename(columns={'销售额': '2024Q1-Q3销售额'})

# 合并数据
result = pd.merge(curr_stats, prev_stats, on='渠道分类', how='outer').fillna(0)

# 计算总销售额用于计算份额
total_curr = result['2025Q1-Q3销售额'].sum()
total_prev = result['2024Q1-Q3销售额'].sum()

# 计算指标
# 1. 同比增长率
mask_growth = result['2024Q1-Q3销售额'] > 0
result['同比增长(%)'] = 0.0
result.loc[mask_growth, '同比增长(%)'] = ((result.loc[mask_growth, '2025Q1-Q3销售额'] - result.loc[mask_growth, '2024Q1-Q3销售额']) / result.loc[mask_growth, '2024Q1-Q3销售额'] * 100).round(1)

# 2. 份额
result['2025份额(%)'] = 0.0
if total_curr > 0:
    result['2025份额(%)'] = (result['2025Q1-Q3销售额'] / total_curr * 100).round(1)

result['2024份额(%)'] = 0.0
if total_prev > 0:
    result['2024份额(%)'] = (result['2024Q1-Q3销售额'] / total_prev * 100).round(1)

# 3. 份额变化
result['份额变化'] = (result['2025份额(%)'] - result['2024份额(%)']).round(1)

# 数据类型转换与排序
result['2025Q1-Q3销售额'] = result['2025Q1-Q3销售额'].astype('int64')
result['2024Q1-Q3销售额'] = result['2024Q1-Q3销售额'].astype('int64')

result = result.sort_values('2025Q1-Q3销售额', ascending=False).reset_index(drop=True)
