import pandas as pd

# 1. 确定时间范围 (最新MAT)
mat_quarters = ['2024Q4', '2025Q1', '2025Q2', '2025Q3']
df_mat = df[df['年季'].isin(mat_quarters)]

# 2. 计算所有城市的总销售额并获取前十城市
city_sales = df_mat.groupby('城市')['销售额'].sum().reset_index()
top10_cities = city_sales.sort_values('销售额', ascending=False).head(10)
top10_cities_list = top10_cities['城市'].tolist()

# 3. 筛选前十城市的数据
df_top10 = df_mat[df_mat['城市'].isin(top10_cities_list)]

# 4. 计算前十城市的总销售额 (分母)
market_total = df_top10.groupby('城市')['销售额'].sum().reset_index().rename(columns={'销售额': '城市总销售额'})

# 5. 计算前十城市中康缘的销售额 (分子)
kangyuan_sales = df_top10[df_top10['生产企业'].str.contains('康缘', na=False)].groupby('城市')['销售额'].sum().reset_index().rename(columns={'销售额': '康缘销售额'})

# 6. 合并数据
result = pd.merge(market_total, kangyuan_sales, on='城市', how='left')
result['康缘销售额'] = result['康缘销售额'].fillna(0)

# 7. 计算份额
result['份额(%)'] = 0.0
mask = result['城市总销售额'] > 0
result.loc[mask, '份额(%)'] = (result.loc[mask, '康缘销售额'] / result.loc[mask, '城市总销售额'] * 100).round(1)

# 8. 格式化与排序 (按总销售额降序，保持Top10顺序)
result = result.sort_values('城市总销售额', ascending=False).reset_index(drop=True)
result['城市总销售额'] = result['城市总销售额'].astype('int64')
result['康缘销售额'] = result['康缘销售额'].astype('int64')

