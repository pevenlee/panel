import pandas as pd
import numpy as np

# 1. 定义时间周期 (YTD逻辑)
current_periods = ['2025Q1', '2025Q2', '2025Q3']
previous_periods = ['2024Q1', '2024Q2', '2024Q3']

# 2. 筛选在分析范围内的数据
# 标记时间周期
df_filtered = df[df['年季'].isin(current_periods + previous_periods)].copy()
df_filtered['Period'] = df_filtered['年季'].apply(lambda x: 'Current' if x in current_periods else 'Previous')

# 3. 确定“康缘”及其所在的“定义市场”
# 筛选康缘的数据作为分子来源
df_ky = df_filtered[df_filtered['生产企业'].str.contains('康缘', na=False)].copy()
# 获取康缘参与竞争的定义市场集合
ky_markets = df_ky['定义市场'].unique()
# 筛选这些定义市场的全量数据作为分母来源
df_market = df_filtered[df_filtered['定义市场'].isin(ky_markets)].copy()

# 4. 聚合数据
# 分子：康缘分省份、分时期的销售额
ky_sales = df_ky.groupby(['省份', 'Period'])['销售额'].sum().reset_index()
# 分母：市场分省份、分时期的销售额
market_sales = df_market.groupby(['省份', 'Period'])['销售额'].sum().reset_index()

# 5. 转置为宽表以便计算
ky_pivot = ky_sales.pivot(index='省份', columns='Period', values='销售额').fillna(0)
market_pivot = market_sales.pivot(index='省份', columns='Period', values='销售额').fillna(0)

# 重命名列以防混淆
ky_pivot.columns = ['康缘_Current', '康缘_Previous']
market_pivot.columns = ['市场_Current', '市场_Previous']

# 合并分子分母
result = pd.merge(ky_pivot, market_pivot, left_index=True, right_index=True, how='outer').fillna(0)

# 6. 计算指标
# 销售额 (2025YTD)
result['销售额'] = result['康缘_Current']

# 同比 (%)
# 避免除以0
mask_prev_zero = result['康缘_Previous'] == 0
result['同比(%)'] = 0.0
result.loc[~mask_prev_zero, '同比(%)'] = ((result.loc[~mask_prev_zero, '康缘_Current'] - result.loc[~mask_prev_zero, '康缘_Previous']) / result.loc[~mask_prev_zero, '康缘_Previous'] * 100)
# 如果去年为0且今年大于0，设为 100% (或者保持逻辑上为无穷大，这里通常处理为100或NaN，此处按0或特定逻辑处理，保持数值型则算出结果)
# 为避免inf，上述代码已处理。若只有今年有数，去年无数，增长率严格说是NaN或inf，业务上常展示为100%或空。这里暂按公式计算。

# 份额 (%)
# Current Share
result['份额(%)'] = 0.0
mask_curr_mkt = result['市场_Current'] > 0
result.loc[mask_curr_mkt, '份额(%)'] = (result.loc[mask_curr_mkt, '康缘_Current'] / result.loc[mask_curr_mkt, '市场_Current'] * 100)

# Previous Share (用于计算份额变化)
result['份额_Previous'] = 0.0
mask_prev_mkt = result['市场_Previous'] > 0
result.loc[mask_prev_mkt, '份额_Previous'] = (result.loc[mask_prev_mkt, '康缘_Previous'] / result.loc[mask_prev_mkt, '市场_Previous'] * 100)

# 份额变化
result['份额变化'] = result['份额(%)'] - result['份额_Previous']

# 7. 格式化与排序
result = result.reset_index()
# 按销售额降序排列
result = result.sort_values('销售额', ascending=False)

# 设置数据类型
result['销售额'] = result['销售额'].astype('int64')
result['同比(%)'] = result['同比(%)'].round(1)
result['份额(%)'] = result['份额(%)'].round(1)
result['份额变化'] = result['份额变化'].round(1)

# 选取最终列
result = result[['省份', '销售额', '同比(%)', '份额(%)', '份额变化']]

# 重置索引
result.reset_index(drop=True, inplace=True)
