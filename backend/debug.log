import pandas as pd

# 1. 时间窗口定义 (YTD)
current_quarters = ['2025Q1', '2025Q2', '2025Q3']
prev_quarters = ['2024Q1', '2024Q2', '2024Q3']

# 2. 基础筛选：四川省
df_prov = df[df['省份'] == '四川'].copy()

# 3. 计算市场总额 (分母)
# 2025 YTD
mkt_25 = df_prov[df_prov['年季'].isin(current_quarters)].groupby('定义市场')['销售额'].sum().rename('2025市场总额')
# 2024 YTD
mkt_24 = df_prov[df_prov['年季'].isin(prev_quarters)].groupby('定义市场')['销售额'].sum().rename('2024市场总额')

# 4. 计算康缘业绩 (分子)
# 筛选康缘
df_target = df_prov[df_prov['生产企业'].str.contains('康缘', na=False)]

# 2025 YTD 康缘
target_25 = df_target[df_target['年季'].isin(current_quarters)].groupby('定义市场')['销售额'].sum().rename('2025康缘销售额')
# 2024 YTD 康缘
target_24 = df_target[df_target['年季'].isin(prev_quarters)].groupby('定义市场')['销售额'].sum().rename('2024康缘销售额')

# 提取康缘在该市场的核心产品 (取2025年有销售的产品)
target_products = df_target[df_target['年季'].isin(current_quarters)].groupby('定义市场')['药品名称'].apply(lambda x: '、'.join(x.unique())).rename('康缘核心产品')

# 5. 合并数据
result = pd.concat([mkt_25, mkt_24, target_25, target_24, target_products], axis=1).reset_index()

# 6. 填充NaN为0 (防止无销售导致的计算错误)
cols_to_fill = ['2025市场总额', '2024市场总额', '2025康缘销售额', '2024康缘销售额']
result[cols_to_fill] = result[cols_to_fill].fillna(0)

# 7. 衍生指标计算
# 销售额同比 (%)
result['康缘增速(%)'] = 0.0
mask_growth = result['2024康缘销售额'] > 0
result.loc[mask_growth, '康缘增速(%)'] = ((result.loc[mask_growth, '2025康缘销售额'] - result.loc[mask_growth, '2024康缘销售额']) / result.loc[mask_growth, '2024康缘销售额'] * 100).round(1)

# 市场份额 (%)
result['2025份额(%)'] = 0.0
mask_share25 = result['2025市场总额'] > 0
result.loc[mask_share25, '2025份额(%)'] = (result.loc[mask_share25, '2025康缘销售额'] / result.loc[mask_share25, '2025市场总额'] * 100).round(1)

result['2024份额(%)'] = 0.0
mask_share24 = result['2024市场总额'] > 0
result.loc[mask_share24, '2024份额(%)'] = (result.loc[mask_share24, '2024康缘销售额'] / result.loc[mask_share24, '2024市场总额'] * 100).round(1)

# 份额变动
result['份额变动'] = (result['2025份额(%)'] - result['2024份额(%)']).round(1)

# 8. 数据类型和格式转换
# 销售额转为整数
result['2025康缘销售额'] = result['2025康缘销售额'].astype('int64')
result['2024康缘销售额'] = result['2024康缘销售额'].astype('int64')

# 筛选列并排序
final_columns = ['定义市场', '康缘核心产品', '2025康缘销售额', '康缘增速(%)', '2025份额(%)', '份额变动']
result = result[final_columns].sort_values('2025康缘销售额', ascending=False).reset_index(drop=True)

