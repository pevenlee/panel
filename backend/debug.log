import pandas as pd

# 1. 预处理：提取年份
df['年'] = df['年季'].astype(str).str[:4]

# 2. 定义目标药品关键词映射 (俗称 -> 通用名/商品名关键词)
# 当前数据集中可能不包含这些肿瘤药物，但逻辑需保持完整以应对潜在数据
keywords = [
    '帕博利珠', 'Keytruda', 'K药', 
    '纳武利尤', 'Opdivo', 'O药', 
    '特瑞普利', '拓益', 
    '卡瑞利珠', '艾瑞卡', 
    '信迪利', '达伯舒', 
    '替雷利珠', '百泽安'
]
pattern = '|'.join(keywords)

# 3. 筛选数据
mask = df['药品名称'].str.contains(pattern, case=False, na=False) | \
       df['成分名'].str.contains(pattern, case=False, na=False)
target_df = df[mask].copy()

# 4. 如果筛选结果为空，直接构建空表返回，避免后续报错
if target_df.empty:
    result = pd.DataFrame(columns=['药品名称', '2024销售额', '2024份额(%)', '2025销售额', '2025份额(%)', '份额变化(%)'])
else:
    # 5. 聚合计算：按药品和年份汇总销售额
    sales_by_drug_year = target_df.groupby(['药品名称', '年'])['销售额'].sum().reset_index()
    
    # 6. 计算每年的竞品市场总额 (用于计算SoV份额)
    market_total = target_df.groupby('年')['销售额'].sum().rename('年度总额').reset_index()
    sales_by_drug_year = pd.merge(sales_by_drug_year, market_total, on='年', how='left')
    
    # 7. 计算份额
    sales_by_drug_year['份额'] = (sales_by_drug_year['销售额'] / sales_by_drug_year['年度总额'] * 100).round(1)
    
    # 8. 透视表：转为宽表格式
    pivot_sales = sales_by_drug_year.pivot(index='药品名称', columns='年', values='销售额').fillna(0)
    pivot_share = sales_by_drug_year.pivot(index='药品名称', columns='年', values='份额').fillna(0.0)
    
    # 9. 重命名列并合并
    # 确保2024和2025列存在 (防止数据缺失导致列不存在)
    for y in ['2024', '2025']:
        if y not in pivot_sales.columns: pivot_sales[y] = 0
        if y not in pivot_share.columns: pivot_share[y] = 0.0
        
    result = pd.DataFrame({
        '2024销售额': pivot_sales['2024'].astype('int64'),
        '2024份额(%)': pivot_share['2024'],
        '2025销售额': pivot_sales['2025'].astype('int64'),
        '2025份额(%)': pivot_share['2025']
    })
    
    # 10. 计算份额变化
    result['份额变化(%)'] = (result['2025份额(%)'] - result['2024份额(%)']).round(1)
    
    # 11. 整理最终结果
    result = result.reset_index()

# 12. 最终字段排序
result = result[['药品名称', '2024销售额', '2024份额(%)', '2025销售额', '2025份额(%)', '份额变化(%)']]
