# 2. 计算分母：每个定义市场的总销售额
market_total = df_mat.groupby('定义市场')['销售额'].sum().reset_index().rename(columns={'销售额': '市场总销售额'})

# 3. 计算分子：康缘在每个定义市场的销售额
# 模糊匹配生产企业包含 '康缘'
ky_sales = df_mat[df_mat['生产企业'].str.contains('康缘', na=False)].groupby('定义市场')['销售额'].sum().reset_index().rename(columns={'销售额': '康缘销售额'})

