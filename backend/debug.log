import pandas as pd

# 1. 确定时间范围 (同口径对比：2025前三季度 vs 2024前三季度)
current_periods = ['2025Q1', '2025Q2', '2025Q3']
prior_periods = ['2024Q1', '2024Q2', '2024Q3']
target_periods = current_periods + prior_periods

# 2. 筛选数据
df_sub = df[df['年季'].isin(target_periods)].copy()

# 3. 标记年份 (用于透视列)
df_sub['年份'] = df_sub['年季'].str[:4]

# 4. 分组汇总：渠道分类 x 年份
grouped = df_sub.groupby(['渠道分类', '年份'])['销售额'].sum().unstack(fill_value=0)

# 5. 重命名列
grouped = grouped.rename(columns={'2024': '2024Q1-Q3销售额', '2025': '2025Q1-Q3销售额'})

# 6. 计算变化指标
grouped['增长额'] = grouped['2025Q1-Q3销售额'] - grouped['2024Q1-Q3销售额']

# 计算份额/增长率 (避免除零)
mask_nonzero = grouped['2024Q1-Q3销售额'] > 0
grouped['同比增幅(%)'] = 0.0
grouped.loc[mask_nonzero, '同比增幅(%)'] = (grouped.loc[mask_nonzero, '增长额'] / grouped.loc[mask_nonzero, '2024Q1-Q3销售额'] * 100).round(1)

# 7. 格式调整
grouped['2024Q1-Q3销售额'] = grouped['2024Q1-Q3销售额'].astype('int64')
grouped['2025Q1-Q3销售额'] = grouped['2025Q1-Q3销售额'].astype('int64')
grouped['增长额'] = grouped['增长额'].astype('int64')

# 8. 重置索引输出
result = grouped.reset_index()
result = result.sort_values('2025Q1-Q3销售额', ascending=False)
