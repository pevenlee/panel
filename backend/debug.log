keywords = ['K药', 'O药', '拓益', '艾瑞卡', '达伯舒', '百泽安', '帕博利珠', '纳武利尤', '特瑞普利', '卡瑞利珠', '信迪利', '替雷利珠']
pattern = '|'.join(keywords)

# 1. 计算定义市场总销售额 (分母)
market_size = df.groupby(['年份', '定义市场'])['销售额'].sum().reset_index(name='市场总销售额')

# 2. 筛选目标药物
mask = df['药品名称'].str.contains(pattern, case=False, na=False) | df['成分名'].str.contains(pattern, case=False, na=False)
target_df = df[mask].copy()

# 3. 计算目标药物在各市场的销售额 (分子)
# 先按(年份, 定义市场, 药品名称)聚合，确保与市场总额粒度对齐
drug_market_stats = target_df.groupby(['年份', '定义市场', '药品名称'])['销售额'].sum().reset_index(name='药物销售额')

# 4. 关联市场总额
merged = pd.merge(drug_market_stats, market_size, on=['年份', '定义市场'], how='left')

# 5. 按药品汇总 (处理跨市场情况)
# 假设一个药在不同市场，份额计算为：总销售额 / 所在各市场总规模之和
drug_stats = merged.groupby(['年份', '药品名称']).agg({'药物销售额': 'sum', '市场总销售额': 'sum'}).reset_index()

# 计算份额
drug_stats['份额(%)'] = 0.0
mask_share = drug_stats['市场总销售额'] > 0
drug_stats.loc[mask_share, '份额(%)'] = (drug_stats.loc[mask_share, '药物销售额'] / drug_stats.loc[mask_share, '市场总销售额'] * 100).round(1)

# 6. 透视表 (年份列)
pivot_df = drug_stats.pivot_table(index='药品名称', columns='年份', values=['药物销售额', '份额(%)'], fill_value=0)
# 展平列名
pivot_df.columns = [f'{col[1]}{col[0].replace("药物", "")}' for col in pivot_df.columns]
pivot_df = pivot_df.reset_index()

# 7. 计算份额变化 (2025 - 2024)
if '2024份额(%)' in pivot_df.columns and '2025份额(%)' in pivot_df.columns:
    pivot_df['份额变化'] = (pivot_df['2025份额(%)'] - pivot_df['2024份额(%)']).round(1)
else:
    pivot_df['份额变化'] = 0.0

# 8. 格式化输出
required_cols = ['药品名称', '2024销售额', '2024份额(%)', '2025销售额', '2025份额(%)', '份额变化']
# 补全可能缺失的列
for col in required_cols:
    if col not in pivot_df.columns:
        if '销售额' in col:
            pivot_df[col] = 0
        else:
            pivot_df[col] = 0.0

result = pivot_df[required_cols].copy()
result['2024销售额'] = result['2024销售额'].fillna(0).astype('int64')
result['2025销售额'] = result['2025销售额'].fillna(0).astype('int64')
result = result.sort_values('2025销售额', ascending=False)
