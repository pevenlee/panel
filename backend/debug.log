import pandas as pd
import numpy as np

# 1. 定义时间范围 (YTD口径)
current_ytd = ['2025Q1', '2025Q2', '2025Q3']
last_ytd = ['2024Q1', '2024Q2', '2024Q3']

# 2. 筛选 YTD 数据
df_curr = df[df['年季'].isin(current_ytd)].copy()
df_last = df[df['年季'].isin(last_ytd)].copy()

# 3. 市场总规模 (分母)
mkt_curr = df_curr.groupby('定义市场')['销售额'].sum().reset_index().rename(columns={'销售额': '市场总额_25YTD'})
mkt_last = df_last.groupby('定义市场')['销售额'].sum().reset_index().rename(columns={'销售额': '市场总额_24YTD'})

# 4. 康缘销售情况 (分子)
# 筛选生产企业包含'康缘'的记录
mask_ky_curr = df_curr['生产企业'].str.contains('康缘', na=False)
mask_ky_last = df_last['生产企业'].str.contains('康缘', na=False)

# 提取康缘在该市场销售的产品名称 (用于展示)
ky_products = df_curr[mask_ky_curr].groupby('定义市场')['药品名称'].unique().apply(lambda x: ','.join(x)).reset_index().rename(columns={'药品名称': '涉及产品'})

ky_curr = df_curr[mask_ky_curr].groupby('定义市场')['销售额'].sum().reset_index().rename(columns={'销售额': '康缘销售额_25YTD'})
ky_last = df_last[mask_ky_last].groupby('定义市场')['销售额'].sum().reset_index().rename(columns={'销售额': '康缘销售额_24YTD'})

# 5. 合并数据
result = pd.merge(ky_products, ky_curr, on='定义市场', how='left')
result = pd.merge(result, ky_last, on='定义市场', how='left')
result = pd.merge(result, mkt_curr, on='定义市场', how='left')
result = pd.merge(result, mkt_last, on='定义市场', how='left')

# 6. 计算指标
# 填充NaN为0
result = result.fillna(0)

# 销售额同比 (%)
result['同比增速(%)'] = 0.0
mask_growth = result['康缘销售额_24YTD'] > 0
result.loc[mask_growth, '同比增速(%)'] = ((result.loc[mask_growth, '康缘销售额_25YTD'] - result.loc[mask_growth, '康缘销售额_24YTD']) / result.loc[mask_growth, '康缘销售额_24YTD'] * 100).round(1)

# 市场份额 (%)
result['2025YTD份额(%)'] = 0.0
mask_share_curr = result['市场总额_25YTD'] > 0
result.loc[mask_share_curr, '2025YTD份额(%)'] = (result.loc[mask_share_curr, '康缘销售额_25YTD'] / result.loc[mask_share_curr, '市场总额_25YTD'] * 100).round(1)

result['2024YTD份额(%)'] = 0.0
mask_share_last = result['市场总额_24YTD'] > 0
result.loc[mask_share_last, '2024YTD份额(%)'] = (result.loc[mask_share_last, '康缘销售额_24YTD'] / result.loc[mask_share_last, '市场总额_24YTD'] * 100).round(1)

# 份额变动
result['份额变动'] = (result['2025YTD份额(%)'] - result['2024YTD份额(%)']).round(1)

# 7. 格式化与排序
result['康缘销售额_25YTD'] = result['康缘销售额_25YTD'].astype('int64')
result['康缘销售额_24YTD'] = result['康缘销售额_24YTD'].astype('int64')

# 选择最终列
final_columns = ['定义市场', '涉及产品', '康缘销售额_25YTD', '同比增速(%)', '2025YTD份额(%)', '份额变动']
result = result[final_columns].sort_values('康缘销售额_25YTD', ascending=False).reset_index(drop=True)

