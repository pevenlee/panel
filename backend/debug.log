import pandas as pd

# 1. 计算每个定义市场的总销售额 (分母)
df_market_total = df.groupby('定义市场')['销售额'].sum().reset_index(name='市场总销售额')

# 2. 筛选康缘的数据，并计算其在每个定义市场的销售额 (分子)
# 匹配生产企业中包含'康缘'的记录
df_ky = df[df['生产企业'].str.contains('康缘', na=False)]
df_ky_sales = df_ky.groupby('定义市场')['销售额'].sum().reset_index(name='康缘销售额')

# 3. 合并数据
result = pd.merge(df_market_total, df_ky_sales, on='定义市场', how='left')

# 4. 填充空值并计算份额
result['康缘销售额'] = result['康缘销售额'].fillna(0)
result['份额(%)'] = 0.0
mask = result['市场总销售额'] > 0
result.loc[mask, '份额(%)'] = (result.loc[mask, '康缘销售额'] / result.loc[mask, '市场总销售额'] * 100).round(1)

# 5. 格式化数据
# 销售额转为整数以便阅读
result['市场总销售额'] = result['市场总销售额'].astype('int64')
result['康缘销售额'] = result['康缘销售额'].astype('int64')

# 按份额降序排列
result = result.sort_values(by='份额(%)', ascending=False).reset_index(drop=True)
