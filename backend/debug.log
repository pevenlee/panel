import pandas as pd
import numpy as np

# 1. 时间与数值预处理
df['年份'] = df['年季'].astype(str).str[:4]
df['销售额'] = pd.to_numeric(df['销售额'], errors='coerce').fillna(0)

# 2. 定义药品别名映射
# 映射逻辑：用户简称 -> [通用名, 商品名, 简称]
name_map = {
    'K药': ['K药', 'Keytruda', '帕博利珠单抗'],
    'O药': ['O药', 'Opdivo', '纳武利尤单抗'],
    '拓益': ['拓益', '特瑞普利单抗'],
    '艾瑞卡': ['艾瑞卡', '卡瑞利珠单抗'],
    '达伯舒': ['达伯舒', '信迪利单抗'],
    '百泽安': ['百泽安', '替雷利珠单抗']
}

# 3. 药品匹配函数
def match_drug(row):
    # 合并搜索字段，确保覆盖药品名和成分名
    search_text = str(row['药品名称']) + '|' + str(row['成分名'])
    for std_name, keywords in name_map.items():
        for kw in keywords:
            if kw in search_text:
                return std_name
    return None

df['目标药品'] = df.apply(match_drug, axis=1)

# 4. 计算市场总额 (分母)
# 按年份和定义市场汇总，作为份额计算的分母
market_stats = df.groupby(['年份', '定义市场'])['销售额'].sum().reset_index()
market_stats.rename(columns={'销售额': '市场总额'}, inplace=True)

# 5. 筛选目标药品并计算销售额 (分子)
df_target = df[df['目标药品'].notna()].copy()
# 如果没有匹配到数据，创建一个空的DataFrame结构以防止报错
if df_target.empty:
    result = pd.DataFrame(columns=['目标药品', '2024销售额', '2024份额(%)', '2025销售额', '2025份额(%)', '份额变化'])
else:
    drug_stats = df_target.groupby(['目标药品', '年份', '定义市场'])['销售额'].sum().reset_index()

    # 6. 关联计算份额
    merged = pd.merge(drug_stats, market_stats, on=['年份', '定义市场'], how='left')
    # 避免除以0
    merged['份额'] = 0.0
    mask = merged['市场总额'] > 0
    merged.loc[mask, '份额'] = (merged.loc[mask, '销售额'] / merged.loc[mask, '市场总额'] * 100).round(1)

    # 7. 透视表转换 (长转宽)
    # 销售额透视
    pivot_sales = merged.pivot_table(index='目标药品', columns='年份', values='销售额', aggfunc='sum', fill_value=0)
    pivot_sales.columns = [f'{c}销售额' for c in pivot_sales.columns]

    # 份额透视 (加权平均或者直接取值，这里同一药品同一对应一个市场，直接sum即可)
    # 如果同一药品跨多个定义市场，份额应为 (总销售/总市场)，这里简化处理假设单一市场
    pivot_share = merged.pivot_table(index='目标药品', columns='年份', values='份额', aggfunc='mean', fill_value=0)
    pivot_share.columns = [f'{c}份额(%)' for c in pivot_share.columns]

    # 合并结果
    result = pd.concat([pivot_sales, pivot_share], axis=1).fillna(0)

    # 8. 确保包含 2024 和 2025 列 (防止某年无数据)
    for year in ['2024', '2025']:
        if f'{year}销售额' not in result.columns:
            result[f'{year}销售额'] = 0
        if f'{year}份额(%)' not in result.columns:
            result[f'{year}份额(%)'] = 0.0

    # 9. 计算份额变化
    result['份额变化'] = (result['2025份额(%)'] - result['2024份额(%)']).round(1)

    # 10. 格式化与重置索引
    result = result.reset_index()
    
    # 类型转换
    sales_cols = [c for c in result.columns if '销售额' in c]
    for col in sales_cols:
        result[col] = result[col].astype('int64')

    # 选择最终列
    final_cols = ['目标药品', '2024销售额', '2024份额(%)', '2025销售额', '2025份额(%)', '份额变化']
    result = result[final_cols]
