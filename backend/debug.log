# 定义时间范围
current_periods = ['2025Q1', '2025Q2', '2025Q3']
prev_periods = ['2024Q1', '2024Q2', '2024Q3']

# 1. 计算全市场总销售额 (用于计算份额分母)
mask_curr = df['年季'].isin(current_periods)
df_curr_mkt = df[mask_curr]
mkt_sales = df_curr_mkt.groupby('康缘大区')['销售额'].sum().reset_index(name='市场总销售额')

# 2. 筛选康缘数据
mask_ky = df['生产企业'].str.contains('康缘', na=False)
df_ky = df[mask_ky].copy()

# 3. 计算康缘本期销售额
df_ky_curr = df_ky[df_ky['年季'].isin(current_periods)]
ky_sales_curr = df_ky_curr.groupby('康缘大区')['销售额'].sum().reset_index(name='康缘销售额')

# 4. 计算康缘同期销售额 (用于计算增长率)
df_ky_prev = df_ky[df_ky['年季'].isin(prev_periods)]
ky_sales_prev = df_ky_prev.groupby('康缘大区')['销售额'].sum().reset_index(name='康缘去年同期')

# 5. 合并数据
result = pd.merge(ky_sales_curr, ky_sales_prev, on='康缘大区', how='left')
result = pd.merge(result, mkt_sales, on='康缘大区', how='left')

# 6. 计算指标
# 填充空值为0以避免计算错误
result = result.fillna(0)

# 增长率
mask_growth = result['康缘去年同期'] > 0
result['同比增长(%)'] = 0.0
result.loc[mask_growth, '同比增长(%)'] = ((result.loc[mask_growth, '康缘销售额'] - result.loc[mask_growth, '康缘去年同期']) / result.loc[mask_growth, '康缘去年同期'] * 100).round(1)

# 市场份额
mask_share = result['市场总销售额'] > 0
result['市场份额(%)'] = 0.0
result.loc[mask_share, '市场份额(%)'] = (result.loc[mask_share, '康缘销售额'] / result.loc[mask_share, '市场总销售额'] * 100).round(1)

# 7. 格式化与排序
result['康缘销售额'] = result['康缘销售额'].astype('int64')
result = result[['康缘大区', '康缘销售额', '同比增长(%)', '市场份额(%)']]
result = result.sort_values('康缘销售额', ascending=False).reset_index(drop=True)
