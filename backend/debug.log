import pandas as pd
import numpy as np

# 定义时间段
current_periods = ['2025Q1', '2025Q2', '2025Q3']
prior_periods = ['2024Q1', '2024Q2', '2024Q3']

# 基础筛选
df_curr = df[df['年季'].isin(current_periods)]
df_prior = df[df['年季'].isin(prior_periods)]

# 计算市场总规模 (用于分母计算份额)
# 假设主表已经是相关定义市场的集合
mkt_sales = df_curr.groupby('省份')['销售额'].sum().rename('市场总规模')

# 筛选康缘数据
ky_mask_curr = df_curr['生产企业'].str.contains('康缘', na=False)
ky_mask_prior = df_prior['生产企业'].str.contains('康缘', na=False)

# 计算康缘各省份销售额
ky_sales_curr = df_curr[ky_mask_curr].groupby('省份')['销售额'].sum().rename('2025YTD销售额')
ky_sales_prior = df_prior[ky_mask_prior].groupby('省份')['销售额'].sum().rename('2024YTD销售额')

# 合并数据
result = pd.concat([ky_sales_curr, ky_sales_prior, mkt_sales], axis=1).fillna(0)

# 计算指标
# 1. 同比增长
result['同比增长(%)'] = 0.0
mask_growth = result['2024YTD销售额'] > 0
result.loc[mask_growth, '同比增长(%)'] = ((result.loc[mask_growth, '2025YTD销售额'] - result.loc[mask_growth, '2024YTD销售额']) / result.loc[mask_growth, '2024YTD销售额'] * 100).round(1)

# 2. 市场份额
result['份额(%)'] = 0.0
mask_share = result['市场总规模'] > 0
result.loc[mask_share, '份额(%)'] = (result.loc[mask_share, '2025YTD销售额'] / result.loc[mask_share, '市场总规模'] * 100).round(1)

# 格式化输出
result['2025YTD销售额'] = result['2025YTD销售额'].astype('int64')
result = result[['2025YTD销售额', '同比增长(%)', '份额(%)']]

# 整理索引
result.index.name = '省份'
result = result.reset_index()

# 排序
result = result.sort_values('2025YTD销售额', ascending=False)
