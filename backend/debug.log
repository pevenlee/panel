    '拓益', '特瑞普利', 
    '艾瑞卡', '卡瑞利珠', 
    '达伯舒', '信迪利', 
    '百泽安', '替雷利珠'
]
# 构建正则表达式 pattern
pattern = '|'.join(keywords)

# 2. 定义时间范围 (同口径对比: 去除2024Q4，仅对比Q1-Q3)
periods_2024 = ['2024Q1', '2024Q2', '2024Q3']
periods_2025 = ['2025Q1', '2025Q2', '2025Q3']
target_periods = periods_2024 + periods_2025

# 3. 筛选时间窗口内的数据
