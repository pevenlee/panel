import pandas as pd

# 定义时间范围：当前MAT
mat_quarters = ['2024Q4', '2025Q1', '2025Q2', '2025Q3']

# 1. 筛选时间范围
df_filtered = df[df['年季'].isin(mat_quarters)].copy()

# 2. 计算分母：整个定义市场的总销售额
market_total = df_filtered.groupby('定义市场')['销售额'].sum().reset_index()
market_total.rename(columns={'销售额': '市场总销售额'}, inplace=True)

# 3. 计算分子：康缘在每个定义市场的销售额
# 模糊匹配 '生产企业' 中包含 '康缘' 的记录
df_ky = df_filtered[df_filtered['生产企业'].str.contains('康缘', na=False)]
ky_sales = df_ky.groupby('定义市场')['销售额'].sum().reset_index()
ky_sales.rename(columns={'销售额': '康缘销售额'}, inplace=True)

# 4. 合并数据
result = pd.merge(market_total, ky_sales, on='定义市场', how='left')

# 5. 填充空值为0 (因为有些市场康缘可能没有销售)
result['康缘销售额'] = result['康缘销售额'].fillna(0)

# 6. 计算份额(%)
result['份额(%)'] = 0.0
mask = result['市场总销售额'] > 0
result.loc[mask, '份额(%)'] = (result.loc[mask, '康缘销售额'] / result.loc[mask, '市场总销售额'] * 100).round(1)

# 7. 格式化数据类型
result['市场总销售额'] = result['市场总销售额'].astype('int64')
result['康缘销售额'] = result['康缘销售额'].astype('int64')

# 8. 按份额降序排列
result = result.sort_values('份额(%)', ascending=False).reset_index(drop=True)
