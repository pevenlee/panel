# 1. 时间范围筛选：采用YTD同口径对比 (2024Q1-Q3 vs 2025Q1-Q3)
# 假设当前最新数据截至2025Q3，为保证可比性，2024年也只取前三季度
target_periods = ['2024Q1', '2024Q2', '2024Q3', '2025Q1', '2025Q2', '2025Q3']
df_filtered = df[df['年季'].isin(target_periods)].copy()

# 提取年份
df_filtered['年份'] = df_filtered['年季'].str[:4]

# 2. 定义药物映射逻辑
# 用户口语词 -> 数据集中可能出现的学名或商品名关键词
keywords = {
    'K药': ['K药', '帕博利珠', 'Keytruda'],
    'O药': ['O药', '纳武利尤', 'Opdivo'],
    '拓益': ['拓益', '特瑞普利'],
    '艾瑞卡': ['艾瑞卡', '卡瑞利珠'],
    '达伯舒': ['达伯舒', '信迪利'],
    '百泽安': ['百泽安', '替雷利珠']
}

# 打标函数
def tag_product(name):
    if not isinstance(name, str):
        return None
    for label, patterns in keywords.items():
        for pat in patterns:
            if pat in name:
                return label
    return None

# 应用打标
df_filtered['目标药物'] = df_filtered['药品名称'].apply(tag_product)

# 3. 计算市场总销售额 (按定义市场和年份，作为分母)
market_stats = df_filtered.groupby(['定义市场', '年份'])['销售额'].sum().reset_index()
market_stats.rename(columns={'销售额': '市场总额'}, inplace=True)

# 4. 计算目标药物销售额 (作为分子)
# 先筛选出目标药物
df_products = df_filtered.dropna(subset=['目标药物']).copy()
product_stats = df_products.groupby(['目标药物', '定义市场', '年份'])['销售额'].sum().reset_index()

# 5. 关联计算份额
merged = pd.merge(product_stats, market_stats, on=['定义市场', '年份'], how='left')
merged['份额(%)'] = 0.0
mask = merged['市场总额'] > 0
merged.loc[mask, '份额(%)'] = (merged.loc[mask, '销售额'] / merged.loc[mask, '市场总额'] * 100).round(1)

# 6. 数据透视：转为宽表格式以便对比
# 需要显示的指标：销售额, 份额(%)
pivot_sales = merged.pivot_table(index='目标药物', columns='年份', values='销售额', fill_value=0)
pivot_share = merged.pivot_table(index='目标药物', columns='年份', values='份额(%)', fill_value=0)

# 重命名列以区分年份
pivot_sales.columns = [f'{col}销售额' for col in pivot_sales.columns]
pivot_share.columns = [f'{col}份额(%)' for col in pivot_share.columns]

# 合并结果
result = pd.concat([pivot_sales, pivot_share], axis=1)

# 7. 计算份额变化 (2025 - 2024)
# 确保列存在（防止某年数据完全缺失）
if '2025份额(%)' in result.columns and '2024份额(%)' in result.columns:
    result['份额变化(pp)'] = (result['2025份额(%)'] - result['2024份额(%)']).round(1)
else:
    result['份额变化(pp)'] = 0.0

# 格式化销售额为整数
for col in result.columns:
    if '销售额' in col:
        result[col] = result[col].astype('int64')

# 重置索引并整理列顺序
result = result.reset_index()

# 动态调整输出列顺序
cols_order = ['目标药物']
for year in ['2024', '2025']:
    cols_order.extend([f'{year}销售额', f'{year}份额(%)'])
cols_order.append('份额变化(pp)')

# 仅保留存在的列
final_cols = [c for c in cols_order if c in result.columns]
result = result[final_cols]

