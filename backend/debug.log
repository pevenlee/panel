import pandas as pd

# 定义时间范围：最新MAT
mat_periods = ['2024Q4', '2025Q1', '2025Q2', '2025Q3']
df_filtered = df[df['年季'].isin(mat_periods)].copy()

# 1. 计算分母：各定义市场的总销售额
market_total = df_filtered.groupby('定义市场')['销售额'].sum().rename('市场总销售额')

# 2. 计算分子：康缘在各定义市场的销售额
# 假设 '康缘' 指代生产企业名称中包含 '康缘' 的记录
kangyuan_sales = df_filtered[df_filtered['生产企业'].str.contains('康缘', na=False)].groupby('定义市场')['销售额'].sum().rename('康缘销售额')

# 3. 合并数据
result = pd.merge(market_total, kangyuan_sales, on='定义市场', how='left')

# 4. 填充NaN值（如果某个市场康缘没有销售，则为0）
result['康缘销售额'] = result['康缘销售额'].fillna(0)

# 5. 计算份额 (%)
result['康缘份额(%)'] = (result['康缘销售额'] / result['市场总销售额'] * 100).round(1)

