# 1. 确定时间范围 (MAT)
mat_periods = ['2024Q4', '2025Q1', '2025Q2', '2025Q3']
df_mat = df[df['年季'].isin(mat_periods)].copy()

# 2. 计算每个定义市场的全市场总销售额 (分母)
market_total = df_mat.groupby('定义市场')['销售额'].sum().rename('市场总销售额')

# 3. 计算康缘在各定义市场的销售额 (分子)
# 筛选生产企业包含'康缘'的记录
ky_mask = df_mat['生产企业'].str.contains('康缘', na=False)
ky_sales = df_mat[ky_mask].groupby('定义市场')['销售额'].sum().rename('康缘销售额')

# 4. 合并数据：以康缘涉足的市场为主
result = pd.merge(ky_sales, market_total, left_index=True, right_index=True, how='left')

# 5. 计算份额
result['份额(%)'] = 0.0
mask_valid = result['市场总销售额'] > 0
