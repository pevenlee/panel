import pandas as pd

# 设定时间范围为最新MAT
mat_quarters = ['2024Q4', '2025Q1', '2025Q2', '2025Q3']
df_filtered = df[df['年季'].isin(mat_quarters)].copy()

# Step 1: 计算每个定义市场的总销售额 (分母)
market_total = df_filtered.groupby('定义市场')['销售额'].sum().reset_index(name='市场总销售额')

# Step 2: 筛选康缘企业的数据并计算销售额 (分子)
# 匹配生产企业中包含“康缘”的记录
df_target = df_filtered[df_filtered['生产企业'].str.contains('康缘', na=False)]
target_sales = df_target.groupby('定义市场')['销售额'].sum().reset_index(name='康缘销售额')

# Step 3: 合并数据
result = pd.merge(market_total, target_sales, on='定义市场', how='left')

# Step 4: 处理缺失值和计算份额
result['康缘销售额'] = result['康缘销售额'].fillna(0)

# 初始化份额列为0.0
result['份额(%)'] = 0.0
# 仅在分母大于0时计算份额，避免除零错误
mask = result['市场总销售额'] > 0
result.loc[mask, '份额(%)'] = (result.loc[mask, '康缘销售额'] / result.loc[mask, '市场总销售额'] * 100).round(1)

# Step 5: 格式化输出
# 销售额转为int64，保留份额为float
result['市场总销售额'] = result['市场总销售额'].astype('int64')
result['康缘销售额'] = result['康缘销售额'].astype('int64')

# 按份额降序排列
result = result.sort_values(by='份额(%)', ascending=False).reset_index(drop=True)
