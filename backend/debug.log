    lambda x: '2024同期' if x in periods_2024 else '2025同期'
)

# 5. 筛选目标药物
# 注意：如果数据中不存在这些药物，df_target将为空
mask_drug = df_period['药品名称'].str.contains(pattern, case=False, na=False)
