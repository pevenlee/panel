import pandas as pd

# 1. 建立别名映射字典 (别名 -> 关键词列表)
keywords_map = {
    'K药': ['帕博利珠', 'Keytruda', '可瑞达', 'K药'],
    'O药': ['纳武利尤', 'Opdivo', '欧狄沃', 'O药'],
    '拓益': ['特瑞普利', '拓益'],
    '艾瑞卡': ['卡瑞利珠', '艾瑞卡'],
    '达伯舒': ['信迪利', '达伯舒'],
    '百泽安': ['替雷利珠', '百泽安']
}

# 2. 定义匹配函数
def match_drug(row):
    name = str(row['药品名称']) + str(row['成分名'])
    for label, kws in keywords_map.items():
        for kw in kws:
            if kw in name:
                return label
    return None

# 3. 应用匹配并筛选数据
df['目标药物'] = df.apply(match_drug, axis=1)
df_target = df[df['目标药物'].notna()].copy()

# 4. 提取年份
df_target['年份'] = df_target['年季'].str[:4]

# 5. 聚合计算销售额
# 维度: 年份, 目标药物
grouped = df_target.groupby(['年份', '目标药物'], as_index=False)['销售额'].sum()

# 6. 计算年度市场总额 (PD-1市场内份额)
year_totals = grouped.groupby('年份')['销售额'].sum().rename('年度总销售额')
grouped = pd.merge(grouped, year_totals, on='年份', how='left')

# 7. 计算份额
grouped['份额(%)'] = (grouped['销售额'] / grouped['年度总销售额'] * 100).round(1)

# 8. 透视表格 (Pivot) 以展示对比
# 销售额透视
pivot_sales = grouped.pivot(index='目标药物', columns='年份', values='销售额').fillna(0).astype('int64')
pivot_sales.columns = [f'{col}销售额' for col in pivot_sales.columns]

# 份额透视
pivot_share = grouped.pivot(index='目标药物', columns='年份', values='份额(%)').fillna(0)
pivot_share.columns = [f'{col}份额(%)' for col in pivot_share.columns]

# 合并结果
result = pd.concat([pivot_sales, pivot_share], axis=1)

# 9. 计算份额变化 (2025 - 2024)
# 检查列是否存在以避免KeyError
if '2025份额(%)' in result.columns and '2024份额(%)' in result.columns:
    result['份额变化(pp)'] = (result['2025份额(%)'] - result['2024份额(%)']).round(1)
else:
    result['份额变化(pp)'] = 0.0

# 10. 整理列顺序和索引
result.reset_index(inplace=True)

# 若结果为空(因数据集中无相关西药)，构建空表返回结构
if result.empty:
    cols = ['目标药物', '2024销售额', '2025销售额', '2024份额(%)', '2025份额(%)', '份额变化(pp)']
    result = pd.DataFrame(columns=cols)

