import pandas as pd

# 用户输入'恒瑞销售清空'，根据上下文推测意为'恒瑞销售情况'
# 筛选生产企业中包含'恒瑞'的记录
df_filtered = df[df['生产企业'].str.contains('恒瑞', na=False)]

# 按药品名称分组统计销售额和销售量
result = df_filtered.groupby('药品名称', as_index=False)[['销售额', '销售量']].sum()

# 按销售额降序排列
result = result.sort_values('销售额', ascending=False)

# 格式化数据
result['销售额'] = result['销售额'].astype('int64')
result['销售量'] = result['销售量'].round(1)

# 重置索引
result.reset_index(drop=True, inplace=True)
