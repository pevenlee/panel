import pandas as pd

# 1. 确定时间范围 (MAT)
mat_quarters = ['2024Q4', '2025Q1', '2025Q2', '2025Q3']
df_mat = df[df['年季'].isin(mat_quarters)]

# 2. 计算分母：每个定义市场的总销售额
market_total = df_mat.groupby('定义市场')['销售额'].sum().reset_index(name='市场总销售额')

# 3. 计算分子：康缘在每个定义市场的销售额
# 匹配生产企业含'康缘'
kangyuan_sales = df_mat[df_mat['生产企业'].str.contains('康缘', na=False)].groupby('定义市场')['销售额'].sum().reset_index(name='康缘销售额')

# 4. 合并数据
result = pd.merge(market_total, kangyuan_sales, on='定义市场', how='left')
result['康缘销售额'] = result['康缘销售额'].fillna(0)

# 5. 计算份额(%)，处理除零风险
result['份额(%)'] = 0.0
mask = result['市场总销售额'] > 0
result.loc[mask, '份额(%)'] = (result.loc[mask, '康缘销售额'] / result.loc[mask, '市场总销售额'] * 100).round(1)

# 6. 格式化输出
result['市场总销售额'] = result['市场总销售额'].astype('int64')
result['康缘销售额'] = result['康缘销售额'].astype('int64')

# 按份额降序排列
result = result.sort_values('份额(%)', ascending=False).reset_index(drop=True)
