import pandas as pd

# 定义时间范围：当前MAT
mat_quarters = ['2024Q4', '2025Q1', '2025Q2', '2025Q3']

# 筛选时间范围内的有效数据
df_mat = df[df['年季'].isin(mat_quarters)].copy()

# 1. 计算每个定义市场的总规模 (分母)
market_total = df_mat.groupby('定义市场')['销售额'].sum().reset_index()
market_total.rename(columns={'销售额': '市场总销售额'}, inplace=True)

# 2. 筛选康缘的数据并计算销售额 (分子)
# 匹配生产企业中包含“康缘”的记录
df_kangyuan = df_mat[df_mat['生产企业'].str.contains('康缘', na=False)]
kangyuan_sales = df_kangyuan.groupby('定义市场')['销售额'].sum().reset_index()
kangyuan_sales.rename(columns={'销售额': '康缘销售额'}, inplace=True)

# 3. 合并数据
result = pd.merge(market_total, kangyuan_sales, on='定义市场', how='left')

# 4. 处理缺失值 (康缘未涉足的市场填0)
result['康缘销售额'] = result['康缘销售额'].fillna(0)

# 5. 计算份额
# 避免除以零
mask = result['市场总销售额'] > 0
result['份额(%)'] = 0.0
result.loc[mask, '份额(%)'] = (result.loc[mask, '康缘销售额'] / result.loc[mask, '市场总销售额'] * 100).round(1)

# 6. 格式化数据
result['市场总销售额'] = result['市场总销售额'].astype('int64')
result['康缘销售额'] = result['康缘销售额'].astype('int64')

# 按份额降序排列
result = result.sort_values(by='份额(%)', ascending=False).reset_index(drop=True)
