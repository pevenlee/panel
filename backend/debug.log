import pandas as pd

# 定义时间段
current_ytd = ['2025Q1', '2025Q2', '2025Q3']
prev_ytd = ['2024Q1', '2024Q2', '2024Q3']

# 1. 准备基础数据
df_curr = df[df['年季'].isin(current_ytd)].copy()
df_prev = df[df['年季'].isin(prev_ytd)].copy()

# 2. 计算2025 YTD 区域总销售额 (用于计算份额分母)
region_total = df_curr.groupby('康缘大区')['销售额'].sum().reset_index().rename(columns={'销售额': '区域总销售额'})

# 3. 计算康缘 2025 YTD 销售额
ky_curr = df_curr[df_curr['生产企业'].str.contains('康缘', na=False)].groupby('康缘大区')['销售额'].sum().reset_index().rename(columns={'销售额': '2025YTD销售额'})

# 4. 计算康缘 2024 YTD 销售额 (用于计算增长)
ky_prev = df_prev[df_prev['生产企业'].str.contains('康缘', na=False)].groupby('康缘大区')['销售额'].sum().reset_index().rename(columns={'销售额': '2024YTD销售额'})

# 5. 合并数据
result = pd.merge(ky_curr, ky_prev, on='康缘大区', how='left')
result = pd.merge(result, region_total, on='康缘大区', how='left')

# 6. 计算指标
# 填充缺失值为0
result = result.fillna(0)

# 销售额取整
result['2025YTD销售额'] = result['2025YTD销售额'].astype('int64')

# 计算同比增长
mask_growth = result['2024YTD销售额'] > 0
result['同比增长(%)'] = 0.0
result.loc[mask_growth, '同比增长(%)'] = ((result.loc[mask_growth, '2025YTD销售额'] - result.loc[mask_growth, '2024YTD销售额']) / result.loc[mask_growth, '2024YTD销售额'] * 100).round(1)

# 计算区域份额
mask_share = result['区域总销售额'] > 0
result['区域份额(%)'] = 0.0
result.loc[mask_share, '区域份额(%)'] = (result.loc[mask_share, '2025YTD销售额'] / result.loc[mask_share, '区域总销售额'] * 100).round(1)

# 7. 整理输出
result = result[['康缘大区', '2025YTD销售额', '同比增长(%)', '区域份额(%)']]
result = result.sort_values('2025YTD销售额', ascending=False)
