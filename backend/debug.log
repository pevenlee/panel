import pandas as pd

# 设定分析时间范围为上下文提供的MAT (2024Q4-2025Q3)
mat_periods = ['2024Q4', '2025Q1', '2025Q2', '2025Q3']
df_mat = df[df['年季'].isin(mat_periods)].copy()

# 1. 计算每个定义市场的全市场总销售额
market_total = df_mat.groupby('定义市场')['销售额'].sum().reset_index()
market_total = market_total.rename(columns={'销售额': '全市场销售额'})

# 2. 筛选康缘的数据，计算康缘在各市场的销售额
# 匹配生产企业中包含'康缘'的记录
kangyuan_sales = df_mat[df_mat['生产企业'].str.contains('康缘', na=False)].groupby('定义市场')['销售额'].sum().reset_index()
kangyuan_sales = kangyuan_sales.rename(columns={'销售额': '康缘销售额'})

# 3. 合并数据
result = pd.merge(market_total, kangyuan_sales, on='定义市场', how='left')

# 4. 填充NaN为0 (康缘未进入的市场)
result['康缘销售额'] = result['康缘销售额'].fillna(0)

# 5. 计算市场份额(%)
# 避免除以0的错误，虽然理论上全市场销售额不应为0
result['康缘份额(%)'] = result.apply(lambda x: (x['康缘销售额'] / x['全市场销售额'] * 100) if x['全市场销售额'] > 0 else 0, axis=1)

# 6. 格式化数据
# 销售额转为整数，份额保留1位小数
result['全市场销售额'] = result['全市场销售额'].astype('int64')
result['康缘销售额'] = result['康缘销售额'].astype('int64')
result['康缘份额(%)'] = result['康缘份额(%)'].astype(float).round(1)

# 7. 按份额降序排列
result = result.sort_values('康缘份额(%)', ascending=False).reset_index(drop=True)

# 输出结果
# result 即为最终结果
