import pandas as pd

# 1. 定义时间范围与同口径筛选 (YTD: Q1-Q3)
# 数据集中最新为2025Q3，因此2024年也只取前三季度进行公平对比
target_periods = ['2024Q1', '2024Q2', '2024Q3', '2025Q1', '2025Q2', '2025Q3']
df_filtered = df[df['年季'].isin(target_periods)].copy()

# 提取年份
df_filtered['年份'] = df_filtered['年季'].str[:4]

# 2. 定义药品关键词映射
drug_map = {
    'K药': ['K药', '帕博利珠', 'Keytruda', '可瑞达'],
    'O药': ['O药', '纳武利尤', 'Opdivo', '欧狄沃'],
    '拓益': ['拓益', '特瑞普利'],
    '艾瑞卡': ['艾瑞卡', '卡瑞利珠'],
    '达伯舒': ['达伯舒', '信迪利'],
    '百泽安': ['百泽安', '替雷利珠']
}

# 3. 标记标准名称
def map_drug_name(row):
    name_str = str(row['药品名称']) + str(row['成分名'])
    for std_name, keywords in drug_map.items():
        for kw in keywords:
            if kw in name_str:
                return std_name
    return None

df_filtered['标准名称'] = df_filtered.apply(map_drug_name, axis=1)

# 筛选出目标药品
df_target = df_filtered.dropna(subset=['标准名称']).copy()

# 4. 汇总销售额
# 即使数据为空，pivot_table 也会返回空DataFrame，不会报错
grouped = df_target.pivot_table(index='标准名称', columns='年份', values='销售额', aggfunc='sum', fill_value=0)

# 确保有2024和2025列，防止某年无数据
for year in ['2024', '2025']:
    if year not in grouped.columns:
        grouped[year] = 0

# 5. 计算市场总额 (仅限这几款竞品的圈内总额)
total_2024 = grouped['2024'].sum()
total_2025 = grouped['2025'].sum()

# 6. 计算份额和变化
# 销售额取整
result = pd.DataFrame()
result['2024销售额'] = grouped['2024'].astype('int64')
result['2025销售额'] = grouped['2025'].astype('int64')

# 份额计算 (避免除以0)
result['2024份额(%)'] = (grouped['2024'] / total_2024 * 100).fillna(0).round(1) if total_2024 > 0 else 0.0
result['2025份额(%)'] = (grouped['2025'] / total_2025 * 100).fillna(0).round(1) if total_2025 > 0 else 0.0

# 份额变化
result['份额变化'] = (result['2025份额(%)'] - result['2024份额(%)']).round(1)

# 重置索引以便展示
result = result.reset_index()
result.index.name = None
