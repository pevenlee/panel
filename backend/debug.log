import pandas as pd

# 1. 范围筛选：同口径对比 (YTD)
# 当前最新数据是 2025Q3，为保证对比公正，2024年也只取 Q1-Q3
target_quarters = ['2024Q1', '2024Q2', '2024Q3', '2025Q1', '2025Q2', '2025Q3']
df_filtered = df[df['年季'].isin(target_quarters)].copy()

# 提取年份
df_filtered['年份'] = df_filtered['年季'].astype(str).str[:4]

# 2. 目标药物筛选
# 构建关键词列表 (含别名及可能的通用名映射)
keywords = ['K药', 'O药', '拓益', '艾瑞卡', '达伯舒', '百泽安', '帕博利珠', '纳武利尤', '特瑞普利', '卡瑞利珠', '信迪利', '替雷利珠']
pattern = '|'.join(keywords)

# 在药品名称或成分名中查找
mask_drug = df_filtered['药品名称'].str.contains(pattern, case=False, na=False) | \
            df_filtered['成分名'].str.contains(pattern, case=False, na=False)
df_target_drugs = df_filtered[mask_drug].copy()

# 3. 计算市场份额的分母 (定义市场总销售额)
# 仅计算筛选出的药物所在的定义市场
market_sales = df_filtered.groupby(['年份', '定义市场'])['销售额'].sum().reset_index()
market_sales.rename(columns={'销售额': '市场总销售额'}, inplace=True)

# 4. 计算目标药物销售额
drug_sales = df_target_drugs.groupby(['年份', '药品名称', '定义市场'])['销售额'].sum().reset_index()

# 5. 关联计算份额
merged = pd.merge(drug_sales, market_sales, on=['年份', '定义市场'], how='left')

# 计算份额并处理除零风险
merged['份额(%)'] = 0.0
mask_valid = merged['市场总销售额'] > 0
merged.loc[mask_valid, '份额(%)'] = (merged.loc[mask_valid, '销售额'] / merged.loc[mask_valid, '市场总销售额'] * 100).round(1)

# 6. 透视表：转为宽表格式 (年份在列)
pivot_df = merged.pivot_table(
    index='药品名称',
    columns='年份',
    values=['销售额', '份额(%)'],
    fill_value=0
)

# 展平多层列名 (e.g. ('销售额', '2024') -> '2024销售额')
pivot_df.columns = [f"{col[1]}{col[0]}" for col in pivot_df.columns]
pivot_df.reset_index(inplace=True)

# 7. 计算份额变化及格式化
# 确保所需列存在
expected_cols = ['2024销售额', '2024份额(%)', '2025销售额', '2025份额(%)']
for col in expected_cols:
    if col not in pivot_df.columns:
        pivot_df[col] = 0

# 计算变化
pivot_df['份额变化(%)'] = (pivot_df['2025份额(%)'] - pivot_df['2024份额(%)']).round(1)

# 格式转换：销售额转为整数
for col in ['2024销售额', '2025销售额']:
    pivot_df[col] = pivot_df[col].astype('int64')

# 输出结果
result = pivot_df[['药品名称', '2024销售额', '2024份额(%)', '2025销售额', '2025份额(%)', '份额变化(%)']]
