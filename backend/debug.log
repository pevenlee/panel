import pandas as pd

# 1. 筛选康缘产品
# 使用 str.contains 模糊匹配生产企业，确保包含“康缘”二字
df_ky = df[df['生产企业'].str.contains('康缘', na=False)].copy()

# 2. 定义时间段 (YTD: Year to Date)
# 2025前三季度
periods_2025 = ['2025Q1', '2025Q2', '2025Q3']
# 2024前三季度 (用于同口径对比)
periods_2024 = ['2024Q1', '2024Q2', '2024Q3']

# 3. 分别筛选数据并汇总
df_25 = df_ky[df_ky['年季'].isin(periods_2025)]
df_24 = df_ky[df_ky['年季'].isin(periods_2024)]

# 按康缘大区汇总销售额
grp_25 = df_25.groupby('康缘大区')['销售额'].sum().rename('2025YTD销售额')
grp_24 = df_24.groupby('康缘大区')['销售额'].sum().rename('2024YTD销售额')

# 4. 合并结果
result = pd.merge(grp_25, grp_24, on='康缘大区', how='outer').fillna(0)

# 5. 计算增长率
# 避免除以0，先初始化为0
result['同比增长(%)'] = 0.0
mask = result['2024YTD销售额'] > 0
result.loc[mask, '同比增长(%)'] = ((result.loc[mask, '2025YTD销售额'] - result.loc[mask, '2024YTD销售额']) / result.loc[mask, '2024YTD销售额'] * 100).round(1)

# 6. 格式化数据
result['2025YTD销售额'] = result['2025YTD销售额'].astype('int64')
result['2024YTD销售额'] = result['2024YTD销售额'].astype('int64')

# 7. 排序与整理
result = result.sort_values('2025YTD销售额', ascending=False)
result.index.name = '康缘大区'
result = result.reset_index()

# 输出最终列
result = result[['康缘大区', '2025YTD销售额', '2024YTD销售额', '同比增长(%)']]
