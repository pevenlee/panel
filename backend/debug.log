import pandas as pd

# 提取年份
df['年份'] = df['年季'].astype(str).str[:4]

# 定义目标药物关键词映射 (包含商品名和对应的通用名成分名)
keywords = ['K药', '帕博利珠', 'Keytruda', 'O药', '纳武利尤', 'Opdivo', '拓益', '特瑞普利', '艾瑞卡', '卡瑞利珠', '达伯舒', '信迪利', '百泽安', '替雷利珠']
pattern = '|'.join(keywords)

# 筛选目标药物
mask_drug = df['药品名称'].str.contains(pattern, case=False, na=False) | df['成分名'].str.contains(pattern, case=False, na=False)
df_target = df[mask_drug].copy()

# 如果筛选为空，直接返回空表结构，防止报错
if df_target.empty:
    result = pd.DataFrame(columns=['药品名称', '2024销售额', '2024份额(%)', '2025销售额', '2025份额(%)', '份额变化'])
else:
    # 确定目标药物所属的定义市场 (用于计算分母)
    target_markets = df_target['定义市场'].unique()
    df_market_total = df[df['定义市场'].isin(target_markets)]

    # 计算市场总销售额 (分母)
    market_stats = df_market_total.groupby(['年份', '定义市场'])['销售额'].sum().reset_index().rename(columns={'销售额': '市场总销'})

    # 计算产品销售额 (分子)
    drug_stats = df_target.groupby(['药品名称', '定义市场', '年份'])['销售额'].sum().reset_index()

    # 关联并计算份额
    merged = pd.merge(drug_stats, market_stats, on=['年份', '定义市场'], how='left')
    merged['份额'] = 0.0
    mask_valid = merged['市场总销'] > 0
    merged.loc[mask_valid, '份额'] = (merged.loc[mask_valid, '销售额'] / merged.loc[mask_valid, '市场总销'] * 100).round(1)

    # 透视表: 行=药品名称, 列=年份
    pivot_sales = merged.pivot_table(index='药品名称', columns='年份', values='销售额', fill_value=0)
    pivot_sales.columns = [f'{col}销售额' for col in pivot_sales.columns]
    
    pivot_share = merged.pivot_table(index='药品名称', columns='年份', values='份额', fill_value=0)
    pivot_share.columns = [f'{col}份额(%)' for col in pivot_share.columns]

    # 合并结果
    result = pd.concat([pivot_sales, pivot_share], axis=1).fillna(0)

    # 确保所需列存在 (防止某一年数据完全缺失导致KeyError)
    for year in ['2024', '2025']:
        if f'{year}销售额' not in result.columns:
            result[f'{year}销售额'] = 0
        if f'{year}份额(%)' not in result.columns:
            result[f'{year}份额(%)'] = 0.0

    # 类型转换
    sales_cols = [c for c in result.columns if '销售额' in c]
    for c in sales_cols:
        result[c] = result[c].astype('int64')

    # 计算份额变化
    result['份额变化'] = (result['2025份额(%)'] - result['2024份额(%)']).round(1)

    # 整理列顺序
    cols = ['2024销售额', '2024份额(%)', '2025销售额', '2025份额(%)', '份额变化']
    result = result[cols].reset_index()
