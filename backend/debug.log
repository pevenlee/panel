df_merged['份额(%)'] = 0.0
mask_nonzero = df_merged['市场总销售额'] > 0
df_merged.loc[mask_nonzero, '份额(%)'] = (df_merged.loc[mask_nonzero, '销售额'] / df_merged.loc[mask_nonzero, '市场总销售额'] * 100).round(1)

# 9. 数据透视 (Pivot) 转为宽表
