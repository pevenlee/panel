import pandas as pd

# 定义时间范围 MAT
mat_quarters = ['2024Q4', '2025Q1', '2025Q2', '2025Q3']

# 1. 基础筛选：四川省 & MAT时间段
df_filtered = df[
    (df['省份'] == '四川') & 
    (df['年季'].isin(mat_quarters))
].copy()

# 2. 计算分母：各个城市的总销售额
city_market_total = df_filtered.groupby('城市')['销售额'].sum().reset_index()
city_market_total.rename(columns={'销售额': '城市总销售额'}, inplace=True)

# 3. 计算分子：康缘在各个城市的销售额
# 模糊匹配生产企业包含'康缘'
mask_ky = df_filtered['生产企业'].str.contains('康缘', na=False)
ky_city_sales = df_filtered[mask_ky].groupby('城市')['销售额'].sum().reset_index()
ky_city_sales.rename(columns={'销售额': '康缘销售额'}, inplace=True)

# 4. 合并数据
result = pd.merge(city_market_total, ky_city_sales, on='城市', how='left')

# 5. 填充空值为0 (部分城市可能没有康缘销售)
result['康缘销售额'] = result['康缘销售额'].fillna(0)

# 6. 计算份额 (注意分母为0的处理)
result['康缘市场份额(%)'] = 0.0
mask_nonzero = result['城市总销售额'] > 0
result.loc[mask_nonzero, '康缘市场份额(%)'] = (
    result.loc[mask_nonzero, '康缘销售额'] / 
    result.loc[mask_nonzero, '城市总销售额'] * 100
).round(1)

# 7. 数据类型转换与排序
