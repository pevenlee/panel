import pandas as pd

# 关联事实表与IPM表以获取ATC和企业信息
df_merged = pd.merge(df_fact, df_ipm[['药品索引', 'ATC1Des', '生产企业']], on='药品索引', how='left')

# 筛选：恒瑞医药 + 指定渠道 (医院, 零售)
# 渠道仅包含 '医院' 和 '零售'，直接筛选即可
cond_ent = df_merged['生产企业'].str.contains('恒瑞', na=False)
cond_channel = df_merged['渠道'].isin(['医院', '零售'])
df_filtered = df_merged[cond_ent & cond_channel].copy()

# 定义聚合逻辑
# 1. MAT 销售额 (最近365天)
mat_sales = df_filtered[df_filtered['年季'].isin(mat_list)].groupby('ATC1Des')['销售额'].sum()

# 2. YTD 销售额 (用于计算增长率)
ytd_sales = df_filtered[df_filtered['年季'].isin(ytd_list)].groupby('ATC1Des')['销售额'].sum()
ytd_prior_sales = df_filtered[df_filtered['年季'].isin(ytd_list_prior)].groupby('ATC1Des')['销售额'].sum()

# 构建结果 DataFrame
result = pd.DataFrame({
    'MAT销售额': mat_sales,
    'YTD销售额': ytd_sales,
    '去年同期YTD': ytd_prior_sales
})

# 填充空值为0 (防止计算错误)
result = result.fillna(0)

# 计算指标
# 份额：各ATC在恒瑞总盘子中的占比
total_mat_sales = result['MAT销售额'].sum()
result['MAT份额(%)'] = (result['MAT销售额'] / total_mat_sales) * 100

# 趋势：YTD同比增长率
# 避免除以0
result['YTD增长率(%)'] = result.apply(lambda x: (x['YTD销售额'] - x['去年同期YTD']) / x['去年同期YTD'] * 100 if x['去年同期YTD'] != 0 else 0, axis=1)

# 格式化与排序
result['MAT销售额'] = result['MAT销售额'].astype('int64')
result['MAT份额(%)'] = result['MAT份额(%)'].round(1)
result['YTD增长率(%)'] = result['YTD增长率(%)'].round(1)

# 选取最终列并排序
result = result[['MAT销售额', 'MAT份额(%)', 'YTD增长率(%)']].sort_values('MAT销售额', ascending=False)

# 重命名索引
result.index.name = 'ATC分类'

# 结果赋值
result = result
