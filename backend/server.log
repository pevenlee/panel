import pandas as pd

# 1. 筛选 Fact 表：时间和渠道
# mat_list 为环境变量，代表最近365天 (如 ['24Q4', '25Q1', '25Q2', '25Q3'])
df_sales = df_fact[
    (df_fact['年季'].isin(mat_list)) & 
    (df_fact['渠道'].isin(['医院', '零售']))
]

# 2. 筛选 IPM 表：生产企业为恒瑞
# 使用 na=False 处理可能存在的空值
mask_pharma = df_ipm['生产企业'].str.contains('恒瑞', na=False)
df_products = df_ipm.loc[mask_pharma, ['药品索引', '生产企业']]

# 3. 关联两表
df_merged = pd.merge(df_sales, df_products, on='药品索引', how='inner')

# 4. 分组汇总
# 按渠道统计销售额
result = df_merged.groupby('渠道')['销售额'].sum().reset_index()

# 5. 格式化数据
# 销售额取整
result['销售额'] = result['销售额'].astype('int64')

# 按销售额降序排列
result = result.sort_values(by='销售额', ascending=False).reset_index(drop=True)
