import pandas as pd

# 关联事实表和属性表
df_merge = pd.merge(df_fact, df_ipm[['药品索引', '生产企业', 'ATC1Des']], on='药品索引', how='inner')

# 筛选渠道 (医院 + 零售)
df_merge = df_merge[df_merge['渠道'].isin(['医院', '零售'])]

# 筛选企业 (恒瑞)
df_merge = df_merge[df_merge['生产企业'].str.contains('恒瑞', na=False)]

# 按维度汇总销售额
df_group = df_merge.groupby(['年季', '生产企业', 'ATC1Des'])['销售额'].sum().reset_index()

# 排序以进行环比计算
df_group.sort_values(by=['生产企业', 'ATC1Des', '年季'], inplace=True)

# 计算环比: (本季 - 上季) / 上季
# 对每个企业和ATC分类内部进行shift
df_group['上季销售额'] = df_group.groupby(['生产企业', 'ATC1Des'])['销售额'].shift(1)
df_group['环比(%)'] = (df_group['销售额'] - df_group['上季销售额']) / df_group['上季销售额'] * 100

# 计算同比: (本季 - 去年同季) / 去年同季
# 构造辅助列用于匹配
df_group['Year'] = df_group['年季'].str[:4].astype(int)
df_group['Quarter'] = df_group['年季'].str[-2:]
df_group['Prev_Year_Key'] = (df_group['Year'] - 1).astype(str) + df_group['Quarter']

# 自关联获取去年同期数据
df_prev = df_group[['年季', '生产企业', 'ATC1Des', '销售额']].rename(columns={'年季': 'Prev_Year_Key', '销售额': '去年同期销售额'})
df_final = pd.merge(df_group, df_prev, on=['Prev_Year_Key', '生产企业', 'ATC1Des'], how='left')

df_final['同比(%)'] = (df_final['销售额'] - df_final['去年同期销售额']) / df_final['去年同期销售额'] * 100

# 格式化数据
df_final['销售额'] = df_final['销售额'].fillna(0).astype('int64')
df_final['同比(%)'] = df_final['同比(%)'].round(1)
df_final['环比(%)'] = df_final['环比(%)'].round(1)

# 重命名并提取最终列
df_final.rename(columns={'ATC1Des': 'ATC1'}, inplace=True)
result = df_final[['生产企业', 'ATC1', '销售额', '同比(%)', '环比(%)', '年季']]

# 最终结果赋值
results = {'恒瑞销售趋势': result}
