import pandas as pd

# 1. 时间范围筛选：使用环境变量 mat_list (最近365天)
df_fact_filtered = df_fact[df_fact['年季'].isin(mat_list)].copy()

# 2. 关联药品属性表 (IPM) 以获取企业信息
# 仅提取必要字段减少内存消耗
df_ipm_subset = df_ipm[['药品索引', '生产企业', '集团名称']]
df_merged = pd.merge(df_fact_filtered, df_ipm_subset, on='药品索引', how='inner')

# 3. 筛选企业：恒瑞
# 匹配逻辑：生产企业 或 集团名称 中包含 '恒瑞'
mask_hengrui = (
    df_merged['生产企业'].str.contains('恒瑞', na=False) | 
    df_merged['集团名称'].str.contains('恒瑞', na=False)
)
df_target = df_merged[mask_hengrui]

# 4. 筛选渠道：核心医院渠道(医院) 和 实体零售渠道(零售)
# df_fact 中渠道仅有 '医院' 和 '零售'，此处显式筛选以确保逻辑准确
df_target = df_target[df_target['渠道'].isin(['医院', '零售'])]

# 5. 分组汇总
# 按渠道和年季展示趋势
result_df = df_target.groupby(['渠道', '年季'])['销售额'].sum().reset_index()

# 6. 数据格式化
result_df['销售额'] = result_df['销售额'].astype('int64')
result_df = result_df.sort_values(by=['渠道', '年季'])

# 7. 输出结果
results = {'恒瑞分渠道销售趋势': result_df}
