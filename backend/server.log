import pandas as pd
import numpy as np

# 1. 筛选符合'恒瑞'条件的药品
# 匹配生产企业或集团名称
mask_hengrui = df_ipm['生产企业'].str.contains('恒瑞', na=False) | df_ipm['集团名称'].str.contains('恒瑞', na=False)
df_target_drugs = df_ipm.loc[mask_hengrui, ['药品索引', '生产企业', 'ATC1Des']]

# 2. 关联销售事实表
# 筛选渠道：医院和零售
df_fact_filtered = df_fact[df_fact['渠道'].isin(['医院', '零售'])]
df_merged = pd.merge(df_fact_filtered, df_target_drugs, on='药品索引', how='inner')

# 3. 分组聚合计算季度销售额
# 维度: 生产企业, ATC1, 年季
df_agg = df_merged.groupby(['生产企业', 'ATC1Des', '年季'])['销售额'].sum().reset_index()
df_agg.rename(columns={'生产企业': '企业', 'ATC1Des': 'ATC1'}, inplace=True)

# 4. 计算同比和环比
# 确保按时间排序
df_agg.sort_values(by=['企业', 'ATC1', '年季'], inplace=True)

# 计算环比 (Current vs Previous Quarter)
# 按企业和ATC1分组，取上一行数据
df_agg['Prev_Q_Sales'] = df_agg.groupby(['企业', 'ATC1'])['销售额'].shift(1)
df_agg['环比(%)'] = (df_agg['销售额'] - df_agg['Prev_Q_Sales']) / df_agg['Prev_Q_Sales'] * 100

# 计算同比 (Current vs Same Quarter Last Year)
# 构造去年同期的年季Key
def get_last_year_q(q_str):
    try:
        year = int(q_str[:4])
        suffix = q_str[4:]
        return f"{year-1}{suffix}"
    except:
        return None

df_agg['Last_Year_Q'] = df_agg['年季'].apply(get_last_year_q)

# 准备用于关联的去年数据
df_last_year = df_agg[['企业', 'ATC1', '年季', '销售额']].copy()
df_last_year.rename(columns={'年季': 'Last_Year_Q', '销售额': 'Prev_Y_Sales'}, inplace=True)

# 关联获取去年同期销售额
df_agg = pd.merge(df_agg, df_last_year, on=['企业', 'ATC1', 'Last_Year_Q'], how='left')
df_agg['同比(%)'] = (df_agg['销售额'] - df_agg['Prev_Y_Sales']) / df_agg['Prev_Y_Sales'] * 100

# 5. 数据格式化
# 销售额取整
df_agg['销售额'] = df_agg['销售额'].fillna(0).astype('int64')

# 增长率保留1位小数
for col in ['同比(%)', '环比(%)']:
    df_agg[col] = df_agg[col].replace([np.inf, -np.inf], np.nan).round(1)

# 提取最终字段
result = df_agg[['企业', 'ATC1', '销售额', '同比(%)', '环比(%)', '年季']]

results = {'恒瑞季度销售表现': result}
