import pandas as pd

# 1. 数据关联
# df_fact 为销售事实表，df_ipm 为产品属性表，通过'药品索引'关联
df_merged = pd.merge(df_fact, df_ipm, on='药品索引', how='inner')

# 2. 筛选'恒瑞'相关产品
# 在集团名称或生产企业中模糊匹配'恒瑞'
mask_corp = df_merged['集团名称'].str.contains('恒瑞', na=False) | df_merged['生产企业'].str.contains('恒瑞', na=False)
df_target = df_merged[mask_corp]

# 3. 筛选渠道
# 核心医院渠道 -> 医院, 实体零售渠道 -> 零售
df_target = df_target[df_target['渠道'].isin(['医院', '零售'])]

# 4. 时间格式对齐与筛选
# 将注入的 mat_list (如 '24Q4') 转换为数据中的格式 (如 '24Q4') 以便筛选最近365天，同时也保留历史数据查看趋势
# 这里展示所有可用数据的趋势，以满足'连续几年'的查看需求

# 5. 分组汇总
# 按年季和渠道汇总销售额
df_trend = df_target.groupby(['年季', '渠道'])['销售额'].sum().reset_index()

# 6. 数据透视
# 将渠道转为列，便于对比
df_pivot = df_trend.pivot(index='年季', columns='渠道', values='销售额').fillna(0)

# 7. 格式化结果
# 销售额取整
result_df = df_pivot.astype('int64').reset_index()
result_df.columns.name = None # 去除列索引名称

# 8. 输出结果
results = {'恒瑞_分渠道销售趋势': result_df}
