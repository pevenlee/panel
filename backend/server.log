import pandas as pd

# 1. 筛选恒瑞相关药品
# 匹配生产企业或集团名称中包含'恒瑞'的记录
mask_hengrui = (df_ipm['生产企业'].str.contains('恒瑞', na=False)) | \
               (df_ipm['集团名称'].str.contains('恒瑞', na=False))
# 提取药品索引及相关维度，并去重防止多对多关联膨胀
df_target_drugs = df_ipm.loc[mask_hengrui, ['药品索引', '生产企业', 'ATC1Des']].drop_duplicates(subset=['药品索引'])

# 2. 关联销售数据
df_merged = pd.merge(df_fact, df_target_drugs, on='药品索引', how='inner')

# 3. 筛选时间范围 2022~2025Q3
# 构建目标季度列表
target_quarters = []
for y in range(2022, 2026):
    for q in range(1, 5):
        q_str = f"{y}Q{q}"
        if q_str <= '25Q3':
            target_quarters.append(q_str)

df_merged = df_merged[df_merged['年季'].isin(target_quarters)]

# 4. 聚合计算
# 按 年季、生产企业、ATC1Des 汇总销售额
df_agg = df_merged.groupby(['年季', '生产企业', 'ATC1Des'])['销售额'].sum().reset_index()

# 5. 计算同比和环比
# 辅助函数：获取上期(QoQ)和同期(YoY)的时间标签
def get_prev_q(yq):
    try:
        y, q = int(yq[:4]), int(yq[-1])
        if q == 1: return f"{y-1}Q4"
        else: return f"{y}Q{q-1}"
    except: return None

def get_prev_y_q(yq):
    try:
        y, q = int(yq[:4]), int(yq[-1])
        return f"{y-1}Q{q}"
    except: return None

df_agg['prev_q'] = df_agg['年季'].apply(get_prev_q)
df_agg['prev_y_q'] = df_agg['年季'].apply(get_prev_y_q)

# 自关联获取环比基数
df_qoq_base = df_agg[['年季', '生产企业', 'ATC1Des', '销售额']].rename(columns={'年季': 'prev_q', '销售额': 'sales_prev_q'})
df_calc = pd.merge(df_agg, df_qoq_base, on=['prev_q', '生产企业', 'ATC1Des'], how='left')

# 自关联获取同比基数
df_yoy_base = df_agg[['年季', '生产企业', 'ATC1Des', '销售额']].rename(columns={'年季': 'prev_y_q', '销售额': 'sales_prev_y'})
df_calc = pd.merge(df_calc, df_yoy_base, on=['prev_y_q', '生产企业', 'ATC1Des'], how='left')

# 计算增长率 (%)
df_calc['环比'] = (df_calc['销售额'] - df_calc['sales_prev_q']) / df_calc['sales_prev_q'] * 100
df_calc['同比'] = (df_calc['销售额'] - df_calc['sales_prev_y']) / df_calc['sales_prev_y'] * 100

# 6. 格式化输出
df_result = df_calc.rename(columns={'生产企业': '企业', 'ATC1Des': 'ATC1'})

# 筛选字段
final_cols = ['企业', 'ATC1', '销售额', '同比', '环比', '年季']
df_result = df_result[final_cols]

# 类型转换与精度处理
df_result['销售额'] = df_result['销售额'].fillna(0).astype('int64')
df_result['同比'] = df_result['同比'].round(1)
df_result['环比'] = df_result['环比'].round(1)

# 排序
df_result = df_result.sort_values(['企业', 'ATC1', '年季']).reset_index(drop=True)

results = {'查询结果': df_result}
