import pandas as pd

# 1. 关联表并筛选字段 (使用 df_ipm 的生产企业信息)
# 仅保留需要的列以优化性能
df_merged = pd.merge(
    df_fact[df_fact['渠道'].isin(['医院', '零售'])], 
    df_ipm[['药品索引', '生产企业']], 
    on='药品索引', 
    how='left'
)

# 2. 时间筛选: 使用当前MAT周期 (mat_list 已在环境中定义)
df_mat = df_merged[df_merged['年季'].isin(mat_list)]

# 3. 计算分母: 各渠道的市场总销售额
df_total = df_mat.groupby('渠道')['销售额'].sum().reset_index().rename(columns={'销售额': '市场总销售额'})

# 4. 计算分子: 恒瑞的销售额
# 模糊匹配 '恒瑞'，处理可能的空值
df_hengrui = df_mat[df_mat['生产企业'].fillna('').str.contains('恒瑞')]
df_hengrui_sales = df_hengrui.groupby('渠道')['销售额'].sum().reset_index().rename(columns={'销售额': '恒瑞销售额'})

# 5. 合并结果并计算份额
df_result = pd.merge(df_hengrui_sales, df_total, on='渠道', how='left')

# 计算份额(%)
df_result['份额(%)'] = (df_result['恒瑞销售额'] / df_result['市场总销售额']) * 100

# 6. 格式化数据
# 销售额取整，份额保留1位小数
df_result['恒瑞销售额'] = df_result['恒瑞销售额'].astype('int64')
df_result['市场总销售额'] = df_result['市场总销售额'].astype('int64')
df_result['份额(%)'] = df_result['份额(%)'].round(1)

# 仅保留关键列展示
df_final = df_result[['渠道', '恒瑞销售额', '份额(%)']]

results = {'恒瑞_MAT分渠道表现': df_final}
