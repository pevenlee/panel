import pandas as pd

# 1. 筛选药品表 (df_ipm) - 匹配恒瑞
# 查找集团名称或生产企业中包含'恒瑞'的记录
mask_hengrui = df_ipm['集团名称'].str.contains('恒瑞', na=False) | df_ipm['生产企业'].str.contains('恒瑞', na=False)
df_ipm_filtered = df_ipm[mask_hengrui][['药品索引', 'ATC2Des']]

# 2. 筛选事实表 (df_fact) - 时间与渠道
# 时间: 使用环境变量 mat_list (最近365天)
# 渠道: 核心医院 -> '医院', 实体零售 -> '零售'
target_channels = ['医院', '零售']
mask_fact = df_fact['年季'].isin(mat_list) & df_fact['渠道'].isin(target_channels)
df_fact_filtered = df_fact[mask_fact]

# 3. 关联表
df_merged = pd.merge(df_fact_filtered, df_ipm_filtered, on='药品索引', how='inner')

# 4. 分组聚合 - 按ATC2分类和季度汇总销售额
df_trend = df_merged.groupby(['ATC2Des', '年季'])['销售额'].sum().reset_index()

# 5. 透视表 - 行: ATC分类, 列: 季度
df_pivot = df_trend.pivot(index='ATC2Des', columns='年季', values='销售额').fillna(0)

# 6. 排序 - 按总销售额降序排列
df_pivot['Total'] = df_pivot.sum(axis=1)
df_pivot = df_pivot.sort_values('Total', ascending=False).drop(columns='Total')

# 7. 格式整理
# 销售额取整
df_pivot = df_pivot.astype('int64')
# 重命名索引和去除列名层级
df_pivot.index.name = 'ATC二级分类'
df_pivot.columns.name = None

results = {'恒瑞各ATC分类销售趋势': df_pivot}
