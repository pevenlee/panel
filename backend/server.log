import pandas as pd
import numpy as np

# 1. 定义时间范围
# 目标时间: 2022Q1 ~ 2025Q3
# 计算所需时间(含同比基期): 2021Q1 ~ 2025Q3
calc_periods = [f"{y}Q{q}" for y in range(2021, 2026) for q in range(1, 5) if f"{y}Q{q}" <= "25Q3"]
target_periods = [p for p in calc_periods if p >= "22Q1"]

# 2. 筛选产品 (IPM表)
# 模糊匹配 '恒瑞'
mask_corp = df_ipm['集团名称'].fillna('').str.contains('恒瑞') | df_ipm['生产企业'].fillna('').str.contains('恒瑞')
df_ipm_target = df_ipm.loc[mask_corp, ['药品索引', 'ATC1Des']].copy()
# 统一企业名称为 '恒瑞'，以便聚合
df_ipm_target['企业'] = '恒瑞'
target_drugs = df_ipm_target['药品索引'].unique()

# 3. 筛选销售数据 (Fact表)
# 渠道: 医院 + 零售
cond_channel = df_fact['渠道'].isin(['医院', '零售'])
cond_time = df_fact['年季'].isin(calc_periods)
cond_drug = df_fact['药品索引'].isin(target_drugs)

df_fact_sub = df_fact[cond_channel & cond_time & cond_drug].copy()

# 4. 关联与聚合
df_merge = pd.merge(df_fact_sub, df_ipm_target, on='药品索引', how='inner')

# 按 企业, ATC1, 年季 聚合
df_agg = df_merge.groupby(['企业', 'ATC1Des', '年季'])['销售额'].sum().reset_index()

# 5. 计算同环比 (使用 Pivot Table 确保时间轴对齐)
# 构建透视表: Index=[企业, ATC1], Columns=年季
df_pivot = df_agg.pivot_table(index=['企业', 'ATC1Des'], columns='年季', values='销售额', aggfunc='sum').fillna(0)

# 确保列按时间顺序排列
sorted_cols = sorted([c for c in df_pivot.columns if c in calc_periods])
df_pivot = df_pivot.reindex(columns=sorted_cols)

# 计算环比 (QoQ, shift 1) 和 同比 (YoY, shift 4)
df_qoq = df_pivot.pct_change(axis=1, periods=1) * 100
df_yoy = df_pivot.pct_change(axis=1, periods=4) * 100

# 6. 提取目标时间段并转换回长表
# 仅保留 2022Q1 ~ 2025Q3
final_cols = [c for c in sorted_cols if c in target_periods]

# 堆叠数据
df_res_sales = df_pivot[final_cols].stack().rename('销售额').reset_index()
df_res_qoq = df_qoq[final_cols].stack().rename('环比(%)').reset_index()
df_res_yoy = df_yoy[final_cols].stack().rename('同比(%)').reset_index()

# 合并结果
result = pd.merge(df_res_sales, df_res_yoy, on=['企业', 'ATC1Des', '年季'], how='left')
result = pd.merge(result, df_res_qoq, on=['企业', 'ATC1Des', '年季'], how='left')

# 7. 格式化
result['销售额'] = result['销售额'].astype('int64')
# 替换 inf 为 nan 并填充 0，保留1位小数
result['同比(%)'] = result['同比(%)'].replace([np.inf, -np.inf], np.nan).fillna(0).round(1)
result['环比(%)'] = result['环比(%)'].replace([np.inf, -np.inf], np.nan).fillna(0).round(1)

# 重命名列以匹配用户要求
result = result.rename(columns={'ATC1Des': 'ATC1'})

# 按时间排序方便查看
result = result.sort_values(['企业', 'ATC1', '年季']).reset_index(drop=True)

